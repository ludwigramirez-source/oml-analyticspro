# ============================================================================
# OMNILEADS ANALYTICS - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================
BACKEND_PORT=8000
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
LOG_LEVEL=INFO

# Timezone de la BD de OmniLeads (como esta configurado en sus envars)
# Se usa para extraer la hora "tal cual" del timestamp
TIMEZONE_DB=America/Bogota

# Unificacion de fechas gestion-llamada.
# True => gestiones se atribuyen al dia del primer evento de la llamada
# (fecha logica) en vez de al dia en que el agente guardo el formulario.
# Arrancar en false para validar conteos en paralelo, luego pasar a true.
USE_FECHA_LOGICA_LLAMADA=false

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_BACKEND_URL=http://localhost:8000

DB_NAME=omnileads_analytics

# ============================================================================
# OMNILEADS POSTGRESQL DATABASE (source - read only)
# ============================================================================
OMNILEADS_DB_HOST=192.168.x.x
OMNILEADS_DB_PORT=5432
OMNILEADS_DB_USER=analitycs_user
OMNILEADS_DB_PASSWORD=YourStrongPassword
OMNILEADS_DB_NAME=omnileads

# ============================================================================
# LOCAL DATABASE (replica sincronizada)
# ============================================================================
USE_LOCAL_DB=true
LOCAL_DB_HOST=postgres-local
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=omnileads_local
LOCAL_DB_USER=analytics
LOCAL_DB_PASSWORD=analytics_password

# ============================================================================
# SYNC SERVICE CONFIGURATION
# ============================================================================
# Intervalo de sync para tablas de eventos (en segundos)
SYNC_INTERVAL_EVENT_LOGS=300
# Intervalo de sync para tablas de referencia (en segundos)
SYNC_INTERVAL_REFERENCE=3600
# Tamano de batch para sync incremental
SYNC_BATCH_SIZE=10000
# Tamano de batch para carga inicial
SYNC_INITIAL_BATCH_SIZE=50000

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# NGINX CONFIGURATION
# ============================================================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============================================================================
# POSTGRESQL ADMIN (pgAdmin) - Development only
# ============================================================================
# PGADMIN_PORT=5050
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=admin

# ============================================================================
# AWS S3 CONFIGURATION (Optional)
# ============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================
# NODE_ENV=production
# ENVIRONMENT=production
